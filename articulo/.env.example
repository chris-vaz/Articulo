# Copy this file to .env and fill in what you need.
# EVERYTHING IS OPTIONAL for local development: the app runs with no .env at all.
# Run `npm run check-env` to see which features are enabled. See SETUP.md for details.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3000
# Public HTTPS tunnel to your machine (e.g. ngrok) so Google can deliver Drive webhooks locally.
NGROK_URI=

# ---------------------------------------------------------------------------
# Database (Postgres: Neon, Supabase, or local)
# Leave empty locally to use `npm run db:dev` (built-in local Postgres).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth: Clerk (https://dashboard.clerk.com)
# Leave empty locally to use Clerk "keyless" mode (temporary dev keys).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Google Drive (Google Cloud console → OAuth client). Also add these credentials
# to Clerk's Google social connection with the Drive scope.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any random string. Google echoes it back so we can reject forged notifications.
GOOGLE_DRIVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Discord (https://discord.com/developers/applications)
# Redirect URI: <NEXT_PUBLIC_URL>/api/auth/callback/discord
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Notion (https://www.notion.so/my-integrations → Public integration)
# Redirect URI: <NEXT_PUBLIC_URL>/api/auth/callback/notion
# ---------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_API_SECRET=

# ---------------------------------------------------------------------------
# Slack (https://api.slack.com/apps). Slack requires an HTTPS redirect URI.
# Redirect URI: <NEXT_PUBLIC_URL>/api/auth/callback/slack
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional: override the redirect URIs above (defaults to NEXT_PUBLIC_URL/api/auth/callback/<provider>)
DISCORD_REDIRECT_URI=
NOTION_REDIRECT_URI=
SLACK_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Uploadcare (profile pictures) https://app.uploadcare.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UPLOADCARE_PUB_KEY=

# ---------------------------------------------------------------------------
# Stripe billing (https://dashboard.stripe.com)
# Webhook endpoint: <NEXT_PUBLIC_URL>/api/stripe/webhook
# Events: customer.subscription.created/updated/deleted, invoice.paid
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
